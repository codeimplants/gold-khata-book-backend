# Backend Environment Variables Example
# Duplicate this file to .env and fill in the values

# Server Port
PORT=7100

# Environment (dev | preprod | prod)
NODE_ENV=dev

# Database URLs — self-hosted MongoDB (NOT Atlas).
# dev runs against a local mongod; preprod/prod point at the MongoDB installed
# on the VPS. Add ?authSource=admin and credentials once auth is enabled there.
DEV_DB_URL=mongodb://localhost:27017/gold_khata_book_dev
PREPROD_DB_URL=mongodb://127.0.0.1:27017/gold_khata_book_preprod
PROD_DB_URL=mongodb://127.0.0.1:27017/gold_khata_book_prod

# Authentication
# Secret key for JWT signing
JWT_SECRET=your_secret_key_here
JWT_PRIVATE_KEY=your_secret_key_here
JWT_PUBLIC_KEY=your_secret_key_here

# Image Storage (ImageKit)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_STORAGE_APP=goldkhatabook

# OTP Service (2Factor.in)
TWOFACTOR_API_KEY=your_2factor_api_key
# Security key for hashing OTP details
HASH_KEY=your_secure_hash_key_here
