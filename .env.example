# Backend Environment Variables Example
# Duplicate this file to .env and fill in the values

# Server Port
# On the VPS: 7110 for prod, 7111 for dev. NOT 7100/7101 — goldrate-backend
# already listens on those. Locally, anything free.
PORT=7111

# Environment (dev | prod)
# src/config/db.ts still accepts `preprod`, but no preprod environment is
# deployed and PREPROD_DB_URL is therefore not set below.
NODE_ENV=dev

# Database URLs — self-hosted MongoDB (NOT Atlas).
#
# Must be a SINGLE-NODE REPLICA SET, not a standalone mongod. order.service.ts
# opens a multi-document transaction, and a standalone rejects it with
# "Transaction numbers are only allowed on a replica set member or mongos".
# A standalone looks completely healthy until someone completes an order.
#
# That is what the ?replicaSet= parameter below is for — it must match the
# replSetName in mongod.conf. Add credentials and ?authSource=admin once auth
# is enabled on the server.
DEV_DB_URL=mongodb://127.0.0.1:27017/gold_khata_book_dev?replicaSet=rs0
PROD_DB_URL=mongodb://127.0.0.1:27017/gold_khata_book_prod?replicaSet=rs0

# Authentication
# Secret key for JWT signing
JWT_SECRET=your_secret_key_here
JWT_PRIVATE_KEY=your_secret_key_here
JWT_PUBLIC_KEY=your_secret_key_here

# Image Storage (ImageKit)
IMAGEKIT_PUBLIC_KEY=your_public_key
IMAGEKIT_PRIVATE_KEY=your_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_STORAGE_APP=goldkhatabook

# OTP: Code Implants Messaging (msg.codeimplants.com) once MESSAGING_API_KEY is
# set, and straight to 2Factor until then (src/common/messaging.ts).
# dev: https://dev.msg.codeimplants.com with an sk_test_ key. Nothing is sent and
# every code is 123456. prod: https://msg.codeimplants.com with an sk_live_ key.
MESSAGING_BASE_URL=https://msg.codeimplants.com
MESSAGING_API_KEY=
# OTP Service (2Factor.in): the fallback until this environment has moved
TWOFACTOR_API_KEY=your_2factor_api_key
# Security key for hashing OTP details
HASH_KEY=your_secure_hash_key_here
