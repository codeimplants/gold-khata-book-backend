{
    "compilerOptions": {
        "module": "CommonJS",

        "target": "ES2020",
        "rootDir": "./src",
        "outDir": "./dist",

        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        "sourceMap": true,
        "skipLibCheck": true,
        "strictNullChecks": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
}
